cc_prebuilt_library_shared {
        name: "libutils-v31",
        strip: {
                none: true,
        },
        target: {
                android_arm64: {
                        srcs: ["libutils-v31.so"],
                },
        },
        compile_multilib: "64",
        check_elf_files: false,
        vendor: true,
}

cc_prebuilt_library_shared {
	name: "libssl-v33",
	strip: {
		none: true,
	},
	target: {
                android_arm: {
                         srcs: ["arm/libssl-v33.so"],
                 },
                 android_arm64: {
                         srcs: ["arm64/libssl-v33.so"],
                 },
	},
        compile_multilib: "both",
	check_elf_files: false,
	vendor: true,
}
