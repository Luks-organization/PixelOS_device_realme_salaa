# for external camera
allow cameraserver init:unix_stream_socket connectto;
allow cameraserver property_socket:sock_file write;
allow cameraserver adb_data_file:file read;
allow cameraserver vendor_oplus_prop:file { getattr open read map };

get_prop(cameraserver, system_oplus_camera_prop)
get_prop(cameraserver, exported_system_prop)
get_prop(cameraserver, vendor_mtk_audio_prop)
